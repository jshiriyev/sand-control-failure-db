# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored -- never commit real credentials here. No production
# credentials or real well data belong in this repo.

POSTGRES_USER=sand_control
POSTGRES_PASSWORD=sand_control
POSTGRES_DB=sand_control

# Used by the backend container to reach the `db` service by its compose
# network name. If running the backend outside Docker against the compose
# Postgres, change `db` to `localhost` and add a `ports: ["5432:5432"]`
# mapping to the db service in docker-compose.yml locally -- never do that
# in anything resembling a shared or production setup.
DATABASE_URL=postgresql+psycopg://sand_control:sand_control@db:5432/sand_control

# Creates a couple of dev-only organizations with known API tokens on
# startup (printed to the backend container's logs). Leave this off for
# anything resembling a real deployment.
SEED_DEV_DATA=true
